rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection (Farmers, Consumers, Bulk Buyers, Admin)
    match /users/{userId} {
      allow read, write: if true;
    }
    // Direct farm produce products
    match /products/{productId} {
      allow read, write: if true;
    }
    // Retail & Wholesale orders
    match /orders/{orderId} {
      allow read, write: if true;
    }
    // Farmer inquiries & messages
    match /enquiries/{enquiryId} {
      allow read, write: if true;
    }
    // Admin product price range limits
    match /admin_price_ranges/{rangeId} {
      allow read, write: if true;
    }
    // Fallback for general collections
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
